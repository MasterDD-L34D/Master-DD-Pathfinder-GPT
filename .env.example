# Esempio di configurazione per Master-DD-Taverna.
# Copia questo file in .env e personalizza i valori.

# Chiave API per gli endpoint protetti (obbligatoria se ALLOW_ANONYMOUS=false)
API_KEY=test

# Consenti accesso senza chiave (solo sviluppo locale)
ALLOW_ANONYMOUS=true

# Consenti dump completo dei moduli (necessario per generate_build_db.py)
ALLOW_MODULE_DUMP=false

# Provider LLM per il RAG: mock | ollama | ollama-openai | openai
# - mock: nessun LLM, restituisce solo i chunk recuperati (default, sicuro)
# - ollama: LLM locale, endpoint nativo Ollama /api/generate
# - ollama-openai: LLM locale, endpoint OpenAI-compatible di Ollama /v1/chat/completions
# - openai: API compatibile OpenAI (cloud o altro backend compatibile), richiede OPENAI_API_KEY
RAG_LLM_PROVIDER=mock

# Ollama (provider=ollama)
# Se Ollama non e' installato: https://ollama.com/download
# Per scaricare un modello: ollama pull qwen2.5-coder:14b
# Default da eval 2026-07-25 (reports/rag_generation_report_qwen14b.json):
# qwen2.5-coder:14b 94% > qwen2.5-coder:7b 89% > gemma3:12b 83%
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# OpenAI-compatibile (provider=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=

# Servizio img-gen /ml/imagine (docs/ML_IMG.md): engine ComfyUI locale
ML_IMG_ENGINE=comfyui
ML_IMG_COMFY_MODEL=sdxl
ML_IMG_COMFY_START_CMD=cmd /c run_nvidia_gpu.bat
ML_IMG_COMFY_START_CWD=C:/AI/ferrospora-spike/ComfyUI_windows_portable
ML_IMG_COMFY_START_TIMEOUT_S=240
# Registry LoRA (alias -> file in ComfyUI/models/loras + strength; cfg/steps
# opzionali = impostazioni consigliate dall'autore del LoRA, IMG-08)
ML_IMG_LORAS={"battlemap": {"file": "dnd_battlemaps_generator_v1.safetensors", "strength": 0.8, "cfg": 5.0, "steps": 35}}
